# Ember deploy — copy to deploy.ps1 (gitignored) and fill in your server details.
# Thin shim over the shared homeserver-deploy engine. Usage: .\deploy.ps1 [-DryRun] [-SkipTests]
$DeployTool = "D:\Programming\Published Projects\homeserver-deploy\Deploy.ps1"  # adjust if your layout differs
$config = @{
    Name       = "ember"
    ServerHost = "your-server-ip"
    ServerUser = "user"
    RemotePath = "/path/to/ember"
    RepoRoot   = $PSScriptRoot
    Tests      = @({ dotnet test tests/Ember.Tests/Ember.Tests.csproj -v q })
    PruneDirs  = @("src", "tests", "docker")
}
& $DeployTool @config @args
