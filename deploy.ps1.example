$ErrorActionPreference = "Stop"

# Copy this file to deploy.ps1, fill in your details, and run it.
# deploy.ps1 is gitignored — your server details stay local.

$server = "user@your-server-ip"
$remotePath = "/path/to/ember"
$publishPath = "./publish"

Write-Host "Publishing bot..." -ForegroundColor Cyan
dotnet publish src/Ember.Bot/Ember.Bot.csproj -c Release -r linux-x64 --self-contained false -o $publishPath

Write-Host "Copying files to server..." -ForegroundColor Cyan
scp -r "$publishPath/*" "${server}:${remotePath}"

Write-Host "Restarting service..." -ForegroundColor Cyan
ssh $server "sudo systemctl restart ember"

Write-Host "Done! Bot restarted successfully." -ForegroundColor Green
