            android:importantForAccessibility="no"
            android:textColor="@color/ember_widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
